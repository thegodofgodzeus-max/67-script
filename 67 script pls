-- MM2 COIN FARM v3.0 - MINIMIZE ÖZELLİKLİ
-- "Kapat" butonu menüyü küçültür, tamamen kapatmaz

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- ================================================
-- AYARLAR
-- ================================================

local Settings = {
    FarmEnabled = true,
    FarmRange = 30,
    FarmDelay = 0.05,
    UseClickDetector = true,
    UseTouchInterest = true,
    UseProximityPrompt = true,
    UseTeleport = true,
    ShowESP = true,
}

-- ================================================
-- COİN BUL (TÜM OLASI İSİMLER)
-- ================================================

local function FindCoins()
    local coins = {}
    local coinNames = {"coin", "money", "cash", "gold", "diamond", "gem", "crystal", "token", "point"}
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            for _, keyword in pairs(coinNames) do
                if name:find(keyword) then
                    table.insert(coins, obj)
                    break
                end
            end
        end
    end
    return coins
end

-- ================================================
-- ESP
-- ================================================

local ESPObjects = {}

local function CreateESP()
    if not Settings.ShowESP then
        for _, data in pairs(ESPObjects) do
            if data then pcall(function() data:Destroy() end) end
        end
        ESPObjects = {}
        return
    end
    
    local localChar = LocalPlayer.Character
    local hrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
    
    local coins = FindCoins()
    for _, coin in pairs(coins) do
        if not ESPObjects[coin] then
            local bill = Instance.new("BillboardGui")
            bill.Size = UDim2.new(0, 120, 0, 60)
            bill.StudsOffset = Vector3.new(0, 2, 0)
            bill.AlwaysOnTop = true
            bill.Adornee = coin
            bill.Parent = coin
            
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 1, 0)
            frame.BackgroundTransparency = 0.2
            frame.BackgroundColor3 = Color3.new(1, 0.8, 0)
            frame.BorderSizePixel = 2
            frame.BorderColor3 = Color3.new(1, 1, 1)
            frame.Parent = bill
            
            local icon = Instance.new("TextLabel")
            icon.Size = UDim2.new(0.5, 0, 1, 0)
            icon.Position = UDim2.new(0, 0, 0, 0)
            icon.BackgroundTransparency = 1
            icon.Text = "💰"
            icon.TextColor3 = Color3.new(1, 1, 1)
            icon.TextScaled = true
            icon.Font = Enum.Font.SourceSansBold
            icon.Parent = frame
            
            local distLabel = Instance.new("TextLabel")
            distLabel.Size = UDim2.new(0.5, 0, 1, 0)
            distLabel.Position = UDim2.new(0.5, 0, 0, 0)
            distLabel.BackgroundTransparency = 1
            distLabel.Text = "0m"
            distLabel.TextColor3 = Color3.new(1, 1, 1)
            distLabel.TextScaled = true
            distLabel.Font = Enum.Font.SourceSans
            distLabel.Parent = frame
            
            local arrow = Instance.new("TextLabel")
            arrow.Size = UDim2.new(0, 30, 0, 30)
            arrow.Position = UDim2.new(0.5, -15, 1, -10)
            arrow.BackgroundTransparency = 1
            arrow.Text = "▼"
            arrow.TextColor3 = Color3.new(1, 0.5, 0)
            arrow.TextScaled = true
            arrow.Font = Enum.Font.SourceSansBold
            arrow.Parent = bill
            
            ESPObjects[coin] = {
                Billboard = bill,
                Frame = frame,
                DistLabel = distLabel,
                Arrow = arrow,
                Part = coin
            }
        end
        
        if hrp and ESPObjects[coin].DistLabel then
            local dist = (coin.Position - hrp.Position).Magnitude
            ESPObjects[coin].DistLabel.Text = string.format("%.1fm", dist)
            
            if dist < 10 then
                ESPObjects[coin].Arrow.TextColor3 = Color3.new(0, 1, 0)
            elseif dist < 20 then
                ESPObjects[coin].Arrow.TextColor3 = Color3.new(1, 0.8, 0)
            else
                ESPObjects[coin].Arrow.TextColor3 = Color3.new(1, 0, 0)
            end
        end
    end
end

-- ================================================
-- TOPLAMA METODLARI
-- ================================================

local function CollectWithClick(part)
    if not Settings.UseClickDetector then return false end
    local cd = part:FindFirstChildOfClass("ClickDetector")
    if cd then
        pcall(function()
            fireclickdetector(cd)
            wait(0.02)
            fireclickdetector(cd)
            return true
        end)
        return true
    end
    return false
end

local function CollectWithTouch(part)
    if not Settings.UseTouchInterest then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        pcall(function()
            firetouchinterest(hrp, part, 0)
            wait(0.05)
            firetouchinterest(hrp, part, 1)
            return true
        end)
        return true
    end
    return false
end

local function CollectWithProximity(part)
    if not Settings.UseProximityPrompt then return false end
    local prompt = part:FindFirstChildOfClass("ProximityPrompt")
    if prompt then
        pcall(function()
            fireproximityprompt(prompt)
            wait(0.02)
            fireproximityprompt(prompt)
            return true
        end)
        return true
    end
    return false
end

local function CollectWithTeleport(part)
    if not Settings.UseTeleport then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        pcall(function()
            local oldPos = hrp.Position
            hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 2, 0))
            wait(0.05)
            CollectWithClick(part)
            CollectWithTouch(part)
            CollectWithProximity(part)
            wait(0.05)
            hrp.CFrame = CFrame.new(oldPos)
            return true
        end)
        return true
    end
    return false
end

-- ================================================
-- ANA FARM
-- ================================================

local function Farm()
    if not Settings.FarmEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local coins = FindCoins()
    local collected = 0
    
    for _, coin in pairs(coins) do
        local dist = (coin.Position - hrp.Position).Magnitude
        if dist > Settings.FarmRange then continue end
        
        local success = false
        
        if not success and Settings.UseClickDetector then
            success = CollectWithClick(coin)
        end
        
        if not success and Settings.UseTouchInterest then
            success = CollectWithTouch(coin)
        end
        
        if not success and Settings.UseProximityPrompt then
            success = CollectWithProximity(coin)
        end
        
        if not success and Settings.UseTeleport then
            success = CollectWithTeleport(coin)
        end
        
        if success then
            collected = collected + 1
        end
        
        wait(Settings.FarmDelay)
    end
    
    if collected > 0 then
        print("[FARM] " .. collected .. " coin toplandı!")
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "💰 COIN FARM",
                Text = collected .. " coin toplandı!",
                Duration = 2,
            })
        end)
    end
end

